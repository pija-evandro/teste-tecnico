{
  "info": {
    "_postman_id": "f340f6ad-9d59-4f8b-a2c5-qa-advantage-search",
    "name": "Advantage Online Shopping - Product Search",
    "description": "Product search API coverage including positive, negative, contract and known issue scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.advantageonlineshopping.com/catalog/api/v1"
    },
    {
      "key": "productName",
      "value": "HP"
    },
    {
      "key": "nonexistentProduct",
      "value": "DefinitelyNotAProduct987654"
    }
  ],
  "item": [
    {
      "name": "Positive",
      "item": [
        {
          "name": "Search products by name",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?name={{productName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{productName}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const products = body.flatMap((category) => category.products || []);",
                  "const term = pm.variables.get('productName').toLowerCase();",
                  "",
                  "pm.test('Search returns matching products', function () {",
                  "  pm.expect(products.length).to.be.above(0);",
                  "",
                  "  products.forEach((product) => {",
                  "    pm.expect(product.productName.toLowerCase()).to.include(term);",
                  "  });",
                  "});",
                  "",
                  "const productSchema = {",
                  "  type: 'object',",
                  "  required: ['productId', 'categoryId', 'productName', 'price', 'imageUrl'],",
                  "  properties: {",
                  "    productId: { type: 'integer', minimum: 1 },",
                  "    categoryId: { type: 'integer', minimum: 1 },",
                  "    productName: { type: 'string', minLength: 1 },",
                  "    price: { type: 'number', minimum: 0 },",
                  "    imageUrl: { type: 'string', minLength: 1 }",
                  "  },",
                  "  additionalProperties: true",
                  "};",
                  "",
                  "const responseSchema = {",
                  "  type: 'array',",
                  "  items: {",
                  "    type: 'object',",
                  "    required: ['categoryId', 'categoryName', 'categoryImageId', 'products'],",
                  "    properties: {",
                  "      categoryId: { type: 'integer', minimum: 1 },",
                  "      categoryName: { type: 'string', minLength: 1 },",
                  "      categoryImageId: { type: 'string', minLength: 1 },",
                  "      products: {",
                  "        type: 'array',",
                  "        items: productSchema",
                  "      }",
                  "    },",
                  "    additionalProperties: true",
                  "  }",
                  "};",
                  "",
                  "pm.test('Response follows the expected contract', function () {",
                  "  pm.response.to.have.jsonSchema(responseSchema);",
                  "});",
                  "",
                  "pm.test('Products belong to their returned category', function () {",
                  "  body.forEach((category) => {",
                  "    category.products.forEach((product) => {",
                  "      pm.expect(product.categoryId).to.eql(category.categoryId);",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative",
      "item": [
        {
          "name": "Search for a nonexistent product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?name={{nonexistentProduct}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{nonexistentProduct}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.test('Service does not return a server error', function () {",
                  "  pm.expect(pm.response.code).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('No unrelated products are returned', function () {",
                  "  const contentType = pm.response.headers.get('Content-Type') || '';",
                  "",
                  "  if (contentType.includes('application/json')) {",
                  "    const body = pm.response.json();",
                  "    const groups = Array.isArray(body) ? body : [];",
                  "    const products = groups.flatMap((category) => category.products || []);",
                  "    pm.expect(products.length).to.eql(0);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
