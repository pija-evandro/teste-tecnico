{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Advantage Search Response",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "categoryId",
      "categoryName",
      "categoryImageId",
      "products"
    ],
    "properties": {
      "categoryId": {
        "type": "integer",
        "minimum": 1
      },
      "categoryName": {
        "type": "string",
        "minLength": 1
      },
      "categoryImageId": {
        "type": "string",
        "minLength": 1
      },
      "products": {
        "type": "array",
        "items": {
          "$ref": "AdvantageProductSchema"
        }
      }
    },
    "additionalProperties": true
  }
}