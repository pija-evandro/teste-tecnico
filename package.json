{
  "name": "teste-tecnico-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Teste técnico de QA com Cypress, Cucumber e JavaScript",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:web": "cypress run --spec \"cypress/e2e/features/web/**/*.feature\"",
    "test:api": "cypress run --spec \"cypress/e2e/features/api/**/*.feature\"",
    "test:smoke": "cypress run --env \"tags=@smoke\"",
    "test:regression": "cypress run --env \"tags=@regression\"",
    "verify": "cypress verify"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "ajv": "^8.20.0",
    "cypress": "15.19.0",
    "esbuild": "0.25.8"
  }
}
